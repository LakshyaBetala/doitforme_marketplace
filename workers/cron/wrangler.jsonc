{
	"$schema": "../../node_modules/wrangler/config-schema.json",
	"name": "doitforme-cron",
	"main": "src/index.ts",
	"compatibility_date": "2026-09-07",
	"compatibility_flags": ["nodejs_compat"],

	// Cloudflare Cron Triggers are UTC, same as Vercel's were.
	//
	// auto-release moves from daily to every 15 minutes. Vercel Hobby forbade
	// anything sub-daily, which meant the 24h auto-release the product promises
	// could take up to ~48h to actually fire. This is the main reason the app is
	// on Cloudflare at all — it costs nothing extra here.
	//
	// The other two keep the exact UTC times they had in vercel.json so their
	// behaviour is unchanged: 07:30 UTC (13:00 IST) and 09:00 UTC (14:30 IST).
	"triggers": {
		"crons": [
			"*/15 * * * *",
			"30 7 * * *",
			"0 9 * * *"
		]
	},

	"vars": {
		// Deliberately the workers.dev hostname, not doitforme.in.
		//
		// Both are served by the same Worker, so the jobs reach identical code
		// either way — but this one has no dependency on the custom domain, the
		// zone staying active, or a certificate renewing. A DNS problem should
		// take the website down, not silently stop escrow from auto-releasing.
		// That decoupling is worth more than the tidiness of a matching URL.
		//
		// It was also the only option during the cutover: doitforme.in pointed at
		// a paused Vercel project, so scheduled calls there 404'd.
		"APP_ORIGIN": "https://doitforme1.doitforme.workers.dev"
	},

	// CRON_SECRET is a secret, not a var:
	//   npx wrangler secret put CRON_SECRET --config workers/cron/wrangler.jsonc
	// It must match the CRON_SECRET set on the main Worker.

	"observability": {
		"enabled": true
	}
}
